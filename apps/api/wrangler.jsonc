{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sizet-openbook-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // 日次レコード・生応答・実行記録の保存先。保存物がそのままハッシュ対象になる。
  "r2_buckets": [
    {
      "binding": "RECORDS",
      "bucket_name": "sizet-openbook-records"
    }
  ],

  "triggers": {
    // 1 回の実行で使える外部への問い合わせ回数に上限があるため、収集を 3 本へ分け、
    // 刻印をさらに別の 1 本で行う。担当範囲は src/triggers.ts が定める。
    // 06:00 前日 + 2〜12 日前 / 06:20 13〜26 日前 / 06:40 27〜40 日前 / 07:00 刻印
    "crons": ["0 6 * * *", "20 6 * * *", "40 6 * * *", "0 7 * * *"]
  }
}
