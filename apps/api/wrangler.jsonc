{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sizet-openbook-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // 画面の静的な資産。資産が先に照合され、該当がなければ Worker が動くため、
  // /v1/* は従来どおり Worker へ届く。資産側に v1 で始まる名前を置かない。
  // API と同一のオリジンで配ることで、有料 API に CORS の設定を加えずに済む。
  "assets": {
    "directory": "../web/dist"
  },

  // 日次レコード・生応答・実行記録の保存先。保存物がそのままハッシュ対象になる。
  "r2_buckets": [
    {
      "binding": "RECORDS",
      "bucket_name": "sizet-openbook-records"
    }
  ],

  "triggers": {
    // 1 回の実行で使える外部への問い合わせ回数に上限があるため、収集を 3 本へ分け、
    // 刻印をさらに別の 1 本で行う。担当範囲は src/triggers.ts が定める。
    // 06:00 前日 + 2〜12 日前 / 06:20 13〜25 日前 / 06:40 26〜40 日前 / 07:00 刻印
    "crons": ["0 6 * * *", "20 6 * * *", "40 6 * * *", "0 7 * * *"]
  }
}
